

# ============================================================================
#  ls / file listing aliases
# ============================================================================

# Basic ls with color and group directories first
alias ls='ls --color=auto --group-directories-first'

# Your requested: ll = long listing, sorted by time (newest at the bottom)
alias ll='ls -ltrh --color=auto'

# Common variations
alias la='ls -A'                    # almost all (show hidden except . and ..)
alias l='ls -CF'                    # classified (append indicator to entries)
alias lla='ls -lah'                 # long + all hidden + human-readable sizes
alias lt='ls -lth'                  # long, sorted by time (newest first)
alias ltr='ls -ltrh'                # long, reverse time (oldest first)
alias lsize='ls -lSh'               # long, sorted by size (largest first)


# ============================================================================
# Navigation & shell basics
# ============================================================================

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias -- -='cd -'                   # go back to previous directory
alias c='clear'


# ============================================================================
# Colored & improved utils (assuming you installed bat, fd, ripgrep, htop)
# ============================================================================
alias bat='batcat'
export BAT_THEME="Dracula"   # or whichever you like
# Use bat instead of cat (syntax highlighting) — fallback to cat if not installed
if command -v bat &> /dev/null || command -v batcat &> /dev/null; then
    alias cat='bat --style=plain --paging=never'
else
    alias cat='cat'
fi

# fd instead of find (much faster)
if command -v fd &> /dev/null; then
    alias find='fd'
fi

# ripgrep instead of grep (faster, better defaults)
if command -v rg &> /dev/null; then
    alias grep='rg'
    alias egrep='rg'
    alias fgrep='rg'
fi

# Better top
alias top='htop'                    # if htop is installed, otherwise falls back


